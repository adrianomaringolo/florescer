# Banco Postgres. Em dev: o container local (pnpm db:up).
# Em produção (Neon): DATABASE_URL = string "Pooled connection" (host com -pooler);
# DATABASE_URL_DIRETA = string sem pooler, usada só pelas migrações.
DATABASE_URL=postgres://florescer:florescer@localhost:5433/florescer
DATABASE_URL_DIRETA=

# URL pública do app (usada nos links do termo e do convite).
APP_URL=http://localhost:3002

# Segredo do endpoint POST /api/solicitacoes (gere com: openssl rand -base64 32).
INTAKE_TOKEN=

# Primeira pessoa usuária criada pelo seed. Sem senha definida, uma é gerada e exibida.
SEED_ADMIN_EMAIL=equipe@florescer.org
SEED_ADMIN_NOME=Equipe Florescer
SEED_ADMIN_SENHA=
